{
  "expo": {
    "name": "Event Compass by Checcas",
    "slug": "event-compass",
    "version": "1.0.0",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.eventcompass.ios"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.eventcompass.android"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundleUrl": null,
      "port": 3000,
      "bundler": "metro"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "scheme": "eventcompass",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Event Compass needs access to your photos to upload service images."
        }
      ]
    ]
  }
}
